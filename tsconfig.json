{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,

        "allowJs": true,
        "checkJs": false,

        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true
    },
    "include": ["src"]
}